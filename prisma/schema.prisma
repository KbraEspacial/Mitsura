generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  name        String
  email       String   @unique
  image                   String?
  googleAccessToken       String?
  googleRefreshToken      String?
  googleCalendarConnected Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  ownedBoards    Board[]
  memberships    BoardMember[]
  assignedTasks  Task[]
  comments       Comment[]
  activities     Activity[]
  financeRecords FinanceRecord[]
  fixedExpenses  FixedExpense[]
  debts          Debt[]
  aiAlerts       AiAlert[]
  incomeSources     IncomeSource[]
  reconciliations   BalanceReconciliation[]
  lifeAreas         LifeArea[]
  categoryAreas     CategoryArea[]
}

model Board {
  id          String   @id @default(cuid())
  title       String
  description String?
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  members BoardMember[]
  columns Column[]
  tasks   Task[]
  activities Activity[]
}

model BoardMember {
  id      String @id @default(cuid())
  role    String @default("MEMBER")

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  boardId String
  board   Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([userId, boardId])
}

model Column {
  id        String   @id @default(cuid())
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  tasks Task[]
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  priority    String   @default("media")
  dueDate     DateTime?
  order       Int
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  assigneeId   String?
  assignee     User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  googleEventId String?

  comments Comment[]
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  message   String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt(sort: Desc)])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  images    String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model FinanceRecord {
  id          String   @id @default(cuid())
  type        String   // "income" | "expense" | "fixed" | "debt_payment"
  amount      Float
  description String
  category    String?
  date        DateTime @default(now())
  isRecurring Boolean  @default(false)

  /// No cuenta para el cálculo del saldo real (transferencias entre tus
  /// cuentas, préstamos recibidos, cobros deDebt, ingresos de terceros).
  /// Solo es una marca: no altera monto, fecha ni descripción.
  excludeFromBalance Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  debtId String?
  debt   Debt?  @relation(fields: [debtId], references: [id])

  sourceId String?
  source   IncomeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
}

/// Línea base del saldo. El usuario confirma cuánto dinero tiene realmente y
/// desde esa fecha la app calcula el saldo por delta de movimientos.
model BalanceReconciliation {
  id     String   @id @default(cuid())
  amount Float
  date   DateTime @default(now())
  note   String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date(sort: Desc)])
}

/// Configurador de sueldo: fuentes de ingreso recurrentes.
model IncomeSource {
  id          String  @id @default(cuid())
  name        String
  amount      Float
  /// "monthly" | "biweekly" | "weekly"
  frequency   String  @default("biweekly")
  dayOfMonth  Int     @default(1)
  /// Segundo día de cobro cuando frequency = "biweekly"
  secondDay   Int?
  category    String?
  isActive    Boolean @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  records FinanceRecord[]

  @@index([userId, isActive])
}

/// Áreas de vida (Alimentación, Transporte, Salud...) con presupuesto mensual.
model LifeArea {
  id            String   @id @default(cuid())
  name          String
  emoji         String?
  /// token de color seguro para Tailwind (ej: "emerald", "amber")
  color         String?
  monthlyBudget Float    @default(0)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categories CategoryArea[]

  @@unique([userId, name])
}

/// Mapea una categoría de FinanceRecord / FixedExpense a un área de vida.
model CategoryArea {
  id       String @id @default(cuid())
  category String
  areaId   String

  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area   LifeArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}


model FixedExpense {
  id          String   @id @default(cuid())
  name        String
  amount      Float
  category    String?
  dayDue      Int      // día de vencimiento (1-31)
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Debt {
  id           String   @id @default(cuid())
  name         String
  totalAmount  Float
  paidAmount   Float    @default(0)
  interestRate Float?
  dueDate      DateTime?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  payments FinanceRecord[]
}

model AiAlert {
  id        String   @id @default(cuid())
  title     String
  message   String
  category  String   // "spending" | "budget" | "fixed_due" | "debt_due" | "deficit" | "insight"
  source    String   @default("rules") // "rules" | "gemini"
  isRead    Boolean  @default(false)
  dedupeKey String   @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
}
